{
  "schemaVersion": 3,
  "language": "zh-Hans",
  "enabled": false,
  "launchAtLogin": true,
  "lowBatteryCapacitySleep": false,
  "lowBatteryCapacity": 15,
  "lowTimeRemaining": 25,
  "disableIdleSleepInCharging": true,
  "disableLidSleepInCharging": true,
  "disableLidSleepOnBattery": true,
  "darkWakeAwarenessEnabled": false,
  "lidSleepImmediateOnClose": true,
  "notificationsEnabled": false,
  "updateCheckEnabled": false,
  "updateCheckIntervalHours": 12,
  "lastUpdateCheckEpochSeconds": 1700000000,
  "hibernateMode": 3,
  "firstRun": false,
  "shelfEnabled": false,
  "screenshotInboxEnabled": false,
  "shelfSoundsEnabled": false,
  "clipboardEnabled": true,
  "clipboardPasteStackHotKey": "shift+cmd+V",
  "clipboardCaptureHotKey": "shift+cmd+C",
  "power": {
    "enabled": true,
    "keepAwakeOnAdapter": true,
    "keepAwakeOnBattery": false,
    "allowClosedLid": true,
    "pauseClosedLidWithExternalDisplay": true,
    "batteryFloorPercent": 15,
    "batteryFloorRecoveryPercent": 20,
    "yieldOnLowPowerMode": true,
    "heatGuardEnabled": true,
    "closedLidTimeCapMinutes": 240,
    "closedLidZeroBrightness": true
  },
  "display": {
    "schemaVersion": 2,
    "keepAwakeWhenLidClosed": true,
    "closedLidPowerPolicy": "any",
    "closedLidDisplayMode": "blackScreenPipeline",
    "pauseWhenExternalDisplayConnected": true
  },
  "chargeLimitEnabled": true,
  "chargeLimitPercent": 70,
  "chargeLimitActiveDischarge": false,
  "fileNaming": {
    "schemaVersion": 1,
    "template": "{title}",
    "maxUTF8Bytes": 240,
    "separator": "-",
    "lowercaseLatin": false,
    "preserveExtension": true,
    "dateSource": "none",
    "conflictPolicy": "appendNumber",
    "conflictSuffix": " ({n})",
    "minConfidence": 0.65,
    "requirePreview": true,
    "allowVision": true
  }
}
